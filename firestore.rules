rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // V3.5 owner workspace model: only the authenticated owner can access this workspace.
    // Signing into the same account on another device gives that account the same synced data.
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == workspaceId;
    }
  }
}
